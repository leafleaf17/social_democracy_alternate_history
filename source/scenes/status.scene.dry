title: Status
new-page: true
is-special: true
on-arrival: {!
if (Q.unemployed) {
    Q.unemployed_2 = Q.unemployed.toFixed(1);
}
if (Q.inflation) {
    Q.inflation_2 = Q.inflation.toFixed(1);
}
Q.economic_growth_2 = '0';
if (Q.economic_growth) {
    Q.economic_growth_2 = Q.economic_growth.toFixed(1);
}
!}

= Status

[+ month : month +] [+ year +]

Resources available: [+ resources +]

SPD position: [? if spd_toleration : toleration ?][? if spd_in_government : in government - ?][? if spd_toleration == 0 and spd_in_government == 0 and spd_caretaker == 0 : opposition ?][? if spd_caretaker : caretaker government ?]
[? if in_weimar_coalition and spd_in_government: Weimar Coalition ?][? if in_grand_coalition and spd_in_government: Grand Coalition ?][? if in_popular_front and spd_in_government: Popular Front ?][? if in_left_front and spd_in_government: Left Front ?][? if in_spd_majority and spd_in_government: SPD majority ?][? if in_minority_government and spd_in_government: minority government ?][? if in_emergency_government and spd_in_government: emergency government ?]

[? if spd_in_government and not in_spd_majority and not in_left_front : Coalition dissent: [+ coalition_dissent : coalition_dissent +] ?]

[? if spd_in_government and (in_left_front or in_popular_front): KPD coalition dissent: [+ kpd_coalition_dissent : coalition_dissent +] ?]

Internal dissent: [+ dissent_percent : dissent +]

= Government

President: [+ president +]

Chancellor: [+ chancellor +] ([+ chancellor_party +])

Reichstag composition:

# 1928: 30, 1930: 25, 1932: 22
{!<span class="tooltip-text" title="Social Democratic Party of Germany">SPD</span>!}: [+ spd_r +]%
[? if sapd_formed and sapd_r > 0: SAPD: [+ sapd_r +]% ?]
# 1928: 15, 1930: 15, 1932: 
{!<span class="tooltip-text" title="Center Party + Bavarian People's Party">Z + BVP</span>!}: [+ z_r +]%
# 1928: 10, 1930: 13
{!<span class="tooltip-text" title="Communist Party of Germany">KPD</span>!}: [+ kpd_r +]%
# 1928: 5, 1930: 4 (as DstP)
{!<span class="tooltip-text" title="German Democratic Party">!}[? if not ddp_name: DDP?][? if ddp_name != 0 : [+ ddp_name +]?]{!</span>!}: [+ ddp_r +]%
# 1928: 9, 1930: 5
{!<span class="tooltip-text" title="German People's Party">DVP</span>!}: [+ dvp_r +]%
# 1928: 14, 1930: 7
{!<span class="tooltip-text" title="German National People's Party">DNVP</span>!}: [+ dnvp_r +]%
# 1928: 3, 1930: 18
{!<span class="tooltip-text" title="National-Socialist German Worker's Party (Nazis)">NSDAP</span>!}: [+ nsdap_r +]%
# 1928: 9, 1930: 10
Others: [+ other_r +]%

[? if spd_in_government = 1 : Budget: [+ budget +] ?]

Next election: [+ next_election_month : month +] [+ next_election_year +]

= Economics

Inflation: [+ inflation_2 +]%

[? if black_thursday_seen = 1 : Unemployment: [+ unemployed_2 +]% ?]

Economic growth: [+ economic_growth_2 +]%



# = Public Opinion

@politics

= Inter-party Relations


{!<span class="tooltip-text" title="Center Party">Z</span>!}: [+ z_relation : relationships +]

{!<span class="tooltip-text" title="German Democratic Party">!}[? if not ddp_name: DDP?][? if ddp_name != 0 : [+ ddp_name +]?]{!</span>!}: [+ ddp_relation : relationships +]

{!<span class="tooltip-text" title="German People's Party">DVP</span>!}: [+ dvp_relation : relationships +]

{!<span class="tooltip-text" title="Communist Party of Germany">KPD</span>!}: [+ kpd_relation : relationships +]

{!<span class="tooltip-text" title="German National People's Party">DNVP</span>!}: [+ dnvp_relation : relationships +]

{!<span class="tooltip-text" title="National-Socialist German Worker's Party (Nazis)">NSDAP</span>!}: [+ nsdap_relation : relationships +]

= Internal Factions of the SPD

{!<span class="tooltip-text" title="The Left is interested in radical, transformative policies and cooperation with the KPD.">Left</span>!} strength: [+ left_strength : strength +], dissent: [+ left_dissent : dissent +]

{!<span class="tooltip-text" title="The Center is a faction of Center Marxists, between reform and revolution.">Center</span>!} strength: [+ center_strength : strength +], dissent: [+ center_dissent : dissent +]

{!<span class="tooltip-text" title="Labor's goal is economic reform and benefits for organized workers.">Labor</span>!} strength: [+ labor_strength : strength +], dissent: [+ labor_dissent : dissent +]

{!<span class="tooltip-text" title="Reformists are pragmatic participants in government, and seek to expand the welfare state and defend democracy.">Reformist</span>!} strength: [+ reformist_strength : strength +], dissent: [+ reformist_dissent : dissent +]

[? if neorevisionism > 0 : Neorevisionist strength: [+ neorevisionist_strength : strength +], dissent: [+ neorevisionist_dissent : dissent +] ?]


@paramilitaries
on-arrival: {!
if (Q.rb_strength) {
    Q.rb_strength_2 = Q.rb_strength.toFixed(1);
}
if (Q.rfb_strength) {
    Q.rfb_strength_2 = Q.rfb_strength.toFixed(1);
}
if (Q.sh_strength) {
    Q.sh_strength_2 = Q.sh_strength.toFixed(1);
}
if (Q.sa_strength) {
    Q.sa_strength_2 = Q.sa_strength.toFixed(1);
}
!}

= Paramilitaries

{!<span class="tooltip-text" title="The Reichsbanner Schwarz-Rot-Gold is a popular organization for defending democracy, mostly affiliated with the SPD.">Reichsbanner</span>!} Strength: [+ rb_strength_2 +] thousand

Reichsbanner Militarization: [+ rb_militancy : militancy +]

{!<span class="tooltip-text" title="The RFB (Rotfrontkämpferbund) is a communist group associated with the KPD.">RFB</span>!} Strength: [+ rfb_strength_2 +] thousand

RFB Militarization: [+ rfb_militancy : militancy +]

{!<span class="tooltip-text" title="The Stahlhelm is a right-wing organization of war veterans associated with the DNVP.">Stahlhelm</span>!} Strength: [+ sh_strength_2 +] thousand

Stahlhelm Militarization: [+ sh_militancy : militancy +]

{!<span class="tooltip-text" title="The SA (Sturmabteilung) is the Nazi paramilitary.">SA</span>!} Strength: [+ sa_strength_2 +] thousand

SA Militarization: [+ sa_militancy : militancy +]

= Official military/paramilitaries

Reichswehr: [+ reichswehr_strength +] thousand troops.

Reichswehr Loyalty: [+ reichswehr_loyalty : loyalty +]

Prussian police: [+ prussian_police_strength +] thousand members.

Prussian police loyalty: [+ prussian_police_loyalty : loyalty +]

[? if spd_in_government : Interior police loyalty: [+ interior_police_loyalty : loyalty +] ?]

@polls
on-arrival: {!
Q.pro_republic_disp = Math.round(Q.pro_republic);
Q.pro_democrat = 100 - Q.pro_republic;
if (Q.pro_democrat < 0) { Q.pro_democrat = 0; }
if (Q.pro_democrat > 100) { Q.pro_democrat = 100; }
Q.pro_democrat_disp = Math.round(Q.pro_democrat);
Q.pro_other_disp = 0;
Q.nationalism_disp = Math.round(Q.nationalism);
Q.socialism_disp = Math.round(Q.socialism);
!}

= Projected election results


on-arrival: {!
    var partyColors = { dem:'#1f4d91', rep:'#b22234', other:'#b0b0b0' };
    function getMarginColor(dem, rep) {
        var diff = dem - rep;
        if (diff >= 15) { return '#172A89'; }
        if (diff >= 5) { return '#244CB5'; }
        if (diff >= 1) { return '#5A7BC7'; }
        if (diff >= 0) { return '#A1B2DD'; }
        if (-diff >= 15) { return '#9E1010'; }
        if (-diff >= 5) { return '#D62F2F'; }
        if (-diff >= 1) { return '#E36666'; }
        return '#F1A1A1';
    }
    var stateSupport = {
        al:{dem:42,rep:54,other:4}, ak:{dem:39,rep:52,other:9}, az:{dem:46,rep:49,other:5}, ar:{dem:43,rep:53,other:4}, ca:{dem:62,rep:32,other:6},
        co:{dem:50,rep:43,other:7}, ct:{dem:58,rep:35,other:7}, de:{dem:54,rep:38,other:8}, fl:{dem:46,rep:51,other:3}, ga:{dem:47,rep:50,other:3},
        hi:{dem:64,rep:28,other:8}, id:{dem:34,rep:58,other:8}, il:{dem:56,rep:37,other:7}, in:{dem:40,rep:56,other:4}, ia:{dem:48,rep:45,other:7},
        ks:{dem:39,rep:55,other:6}, ky:{dem:38,rep:55,other:7}, la:{dem:41,rep:54,other:5}, me:{dem:53,rep:39,other:8}, md:{dem:56,rep:35,other:9},
        ma:{dem:63,rep:29,other:8}, mi:{dem:46,rep:49,other:5}, mn:{dem:52,rep:40,other:8}, mo:{dem:42,rep:53,other:5}, ms:{dem:37,rep:57,other:6},
        mt:{dem:44,rep:49,other:7}, nc:{dem:48,rep:49,other:3}, nd:{dem:33,rep:58,other:9}, ne:{dem:38,rep:56,other:6}, nh:{dem:53,rep:41,other:6},
        nj:{dem:55,rep:36,other:9}, nm:{dem:50,rep:42,other:8}, nv:{dem:49,rep:44,other:7}, ny:{dem:60,rep:31,other:9}, oh:{dem:44,rep:51,other:5},
        ok:{dem:28,rep:65,other:7}, or:{dem:53,rep:38,other:9}, pa:{dem:48,rep:49,other:3}, ri:{dem:58,rep:34,other:8}, sc:{dem:39,rep:56,other:5},
        sd:{dem:35,rep:57,other:8}, tn:{dem:34,rep:58,other:8}, tx:{dem:42,rep:53,other:5}, ut:{dem:22,rep:67,other:11}, va:{dem:44,rep:51,other:5},
        vt:{dem:61,rep:30,other:9}, wa:{dem:56,rep:35,other:9}, wi:{dem:47,rep:49,other:4}, wv:{dem:31,rep:60,other:9}, wy:{dem:20,rep:70,other:10},
        dc:{dem:87,rep:8,other:5}
    };
    var map = document.getElementById('us-election-map');
    var hoverInfo = document.getElementById('us-election-map-hover');
    if (map) {
        Array.prototype.forEach.call(map.querySelectorAll('path[title], circle[title]'), function(path) {
            var state = path.getAttribute('class');
            if (!state) { return; }
            var support = stateSupport[state] || {
                dem: Q.pro_democrat_disp || 50,
                rep: Q.pro_republic_disp || 50,
                other: Q.pro_other_disp || 0
            };
            var winner = support.dem >= support.rep && support.dem >= support.other ? 'dem' : support.rep >= support.dem && support.rep >= support.other ? 'rep' : 'other';
            path.style.fill = winner === 'other' ? partyColors.other : getMarginColor(support.dem, support.rep);
            path.style.stroke = '#ffffff';
            path.style.strokeWidth = '0.4';
            path.style.cursor = 'default';
            path.addEventListener('mouseenter', function() {
                var stateName = path.querySelector('title') ? path.querySelector('title').textContent : state.toUpperCase();
                if (hoverInfo) {
                    hoverInfo.textContent = stateName + ' — Dem ' + support.dem + '%, Rep ' + support.rep + '%, Other ' + support.other + '%';
                }
            });
            path.addEventListener('mouseleave', function() {
                if (hoverInfo) {
                    hoverInfo.textContent = 'Hover over a state to see projected support.';
                }
            });
        });
    }
!}

{!<div id="us-election-map-wrapper" style="max-width:1300px; margin: 0.75rem 0 1rem 0;">
    <div id="us-election-map-info" style="font-size:0.95rem; margin-bottom:0.4rem;">
        <span id="us-election-map-hover">Hover over a state to see projected support.</span>
    </div>
<svg id="us-election-map" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 959 593" style="width:100%; max-width:1300px; height:auto; display:block; margin-bottom:0.5rem;">
  <title>Blank map of the United States, territories not included</title>
<defs>
<style type="text/css">
.state {fill:#D0D0D0}                        /* default color for all states not specified below */
.borders {stroke:#FFFFFF; stroke-width:1}    /* color and width of borders between states */
.dccircle {display:yes}                      /* set display to yes to show the circle for the District of Columbia, or none to hide it */
.separator1 {stroke:#B0B0B0; stroke-width:2} /* color and width of lines around Alaska and Hawaii */

/* Individual states can be colored as follows:
.ks,.mt,.pa {fill:#0000FF}
.ca,.de {fill:#FF0000}
In this example, Kansas, Montana and Pennsylvania are colored blue, and California and Delaware are colored red.
Place this code in the empty space below. */



</style>
</defs>

