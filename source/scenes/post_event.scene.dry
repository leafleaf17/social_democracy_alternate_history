title: Post Event
new-page: true
on-arrival: {!
Q.last_advisor_action = 0;
Q.last_cabinet_action = 0;
// make sure no stat is below 0.
for (var c of Q.classes) {
    for (var party of Q.parties) {
        if (Q[c+'_'+party] < 0) {
            Q[c+'_'+party] = 0;
        }
    }
}

Q.pro_republic = Math.round(Q.pro_republic);
Q.nationalism = Math.round(Q.nationalism);
Q.socialism = Math.round(Q.socialism);

if (Q.pro_republic < 0) {
    Q.pro_republic = 0;
}
if (Q.pro_republic >= 100) {
    Q.pro_republic = 99;
}
// re-calculate party support
// calculate normalized class voting for the achievements
for (var c of Q.classes) {
    var class_votes = 0;
    for (var party of Q.parties) {
        if (Q[c+'_'+party] < 0) {
            Q[c+'_'+party] = 0;
        }
        class_votes += Q[c+'_'+party];
    }
    for (var party of Q.parties) {
        Q[c + '_' + party + '_normalized'] = 100*Q[c+'_'+party]/class_votes;
        Q[c + '_' + party + '_display'] = Math.round(100*Q[c+'_'+party]/class_votes);
    }
}
// calculate support for each of the parties
var total_support = 0; 
for (var party of Q.parties) {
    var party_support = 0;
    for (var c of Q.classes) {
        if (Q.old_demographics) { 
            party_support += Q[c]*Q[c+'_'+party];
        } else  { 
            party_support += Q[c]*Q[c+'_'+party+'_normalized'];
        } 
    }
    Q[party + '_support'] = party_support;
    total_support += party_support; 
}
// 2. normalize support (fraction)
for (var party of Q.parties) {
    Q[party+'_normalized'] = Q[party + '_support']/total_support;
    Q[party+'_votes'] = Math.round(Q[party+'_normalized']*100);
    Q[party+'_votes_display'] = Math.round(Q[party+'_normalized']*100);
}

// set faction strength/dissent to 0
for (var c of Q.factions) {
    if (Q[c+'_dissent'] < 0) {
        Q[c+'_dissent'] = 0;
    } else if (Q[c+'_dissent'] >= 100) {
        Q[c+'_dissent'] = 99;
    }
    if (Q[c+'_strength'] < 0) {
        Q[c+'_strength'] = 0;
    }
}

if (Q.unemployment <= 1) {
    Q.unemployment = 1;
}

// re-calculate dissent.
var total_strength = Q.socialist_strength + Q.progressive_strength + Q.new_liberal_strength + Q.blue_dog_strength + Q.neorevisionist_strength;

// normalize strength for the different factions
Q.socialist_strength = 100*Q.socialist_strength/total_strength;
Q.progressive_strength = 100*Q.progressive_strength/total_strength;
Q.new_liberal_strength = 100*Q.new_liberal_strength/total_strength;
Q.blue_dog_strength = 100*Q.blue_dog_strength/total_strength;
Q.neorevisionist_strength = 100*Q.neorevisionist_strength/total_strength;

var total_dissent = Q.socialist_strength*Q.socialist_dissent + Q.progressive_strength*Q.progressive_dissent + Q.new_liberal_strength*Q.new_liberal_dissent + Q.blue_dog_strength*Q.blue_dog_dissent + Q.neorevisionist_strength*Q.neorevisionist_dissent;

Q.dissent = 0.01*total_dissent/total_strength;
Q.dissent_percent = Q.dissent*100;
console.log('new dissent: ' + Q.dissent);

if (Q.dissent < 0) {
    Q.dissent = 0;
} else if (Q.dissent > 0.95) {
    Q.dissent = 0.95;
}

// 1. update dates & monthly turn logic
if (Q.month_actions >= 1) {
    Q.time += 1;
    Q.month_actions = 0;
    Q.month += 1;
    if (Q.month >= 13) {
        Q.month = 1;
        Q.year += 1;
        if (Q.annual_income > 0) {
            Q.resources += Q.annual_income;
        }
    }
    // decrement timers
    for (var timer of Q.timers) {
        if (Q[timer+'_timer'] && Q[timer+'_timer'] > 0) {
            Q[timer+'_timer'] -= 1;
        }
    }
    
    // append to historical party support records
    var party_support_results = {'date': new Date(Q.year, Q.month - 1)};
    for (var party of Q.parties) {
        party_support_results[party] = Q[party + '_normalized']*100;
    }
    Q.party_support_records.push(party_support_results);
    Q.economic_records.push({'date': new Date(Q.year, Q.month - 1),
                             'inflation': Q.inflation,
                             'unemployment': Q.unemployment});

    // ============================================================================
    // BACKGROUND MACRO, FISCAL IMPULSE & FOMC MEETING LOOP
    // ============================================================================
    var laborInflation = 0;
    if (Q.unemployment < 4.2) {
        laborInflation = (4.2 - Q.unemployment) * 0.08;
    } else if (Q.unemployment > 5.5) {
        laborInflation = -(Q.unemployment - 5.5) * 0.04;
    }

   // Fiscal Impulse from Budget Deficit (Normal peacetime baseline = -20)
// Starting budget (-29) already has +9 deficit gap -> naturally lifts inflation & growth
var deficitGap = -20 - (Number(Q.budget) !== undefined && !isNaN(Number(Q.budget)) ? Number(Q.budget) : -29);
var fiscalGrowthImpulse    = Math.max(-0.15, Math.min(0.25, deficitGap * 0.01));
var fiscalInflationImpulse = Math.max(-0.10, Math.min(0.35, deficitGap * 0.012));
 if (Q.ara > 0) {
    Q.inflation += 0.4
    Q.economic_growth += 0.3
    Q.unemployment -=0.4
    Q.ara -=1
    Q.sp500_event_pct = (Q.sp500_event_pct || 0) + 2.5;
 }
 if (Q.ara_lite > 0) {
    Q.inflation += 0.1
    Q.unemployment -=0.15
    Q.ara_lite -=1
        Q.sp500_event_pct = (Q.sp500_event_pct || 0) + 0.5;
 }
if (Q.andrew_yang_dw === 0 && Q.year === 2021 && Q.month === 9) {
    Q.budget += 8;
}
if (Q.andrew_yang_dw === 1 && Q.year === 2021 && Q.month === 9) {
    Q.budget += 2.5;
}
if (Q.year <= 2021 && Q.month < 9) {
    Q.inflation += 0.2;
    Q.sp500_event_pct = (Q.sp500_event_pct || 0) + 0.5;
}

    // Federal Reserve FOMC Meetings (8 meetings/year: Jan, Mar, May, Jun, Jul, Sep, Nov, Dec)
    
    Q.fomc_met_this_month = 0;

    if (Q.month === 1 || Q.month === 3 || Q.month === 5 || Q.month === 6 || Q.month === 7 || Q.month === 9 || Q.month === 11 || Q.month === 12) {
        Q.fomc_met_this_month = 1;
        var prevStance = Q.fed_stance || 0;

        if (Q.inflation >= 4.5) {
            Q.fed_stance = 2;      // Aggressive rate hikes
        } else if (Q.inflation >= 3.0) {
            Q.fed_stance = 1;      // Moderate tightening
        } else if (Q.inflation <= 1.8 && Q.unemployment > 4.8) {
            Q.fed_stance = -1;     // Dovish / rate cuts
        } else {
            Q.fed_stance = 0;      // Neutral hold
        }

        Q.fed_shifted = (Q.fed_stance !== prevStance) ? 1 : 0;
    } else {
        Q.fed_shifted = 0;
    }


    var fedDragOnGrowth = 0;
    var fedInflationCool = 0;

    if (Q.fed_stance === 2) {
        fedInflationCool = -0.24;
        fedDragOnGrowth  = -0.32;
    } else if (Q.fed_stance === 1) {
        fedInflationCool = -0.09;
        fedDragOnGrowth  = -0.10;
    } else if (Q.fed_stance === -1) {
        fedInflationCool = 0.03;
        fedDragOnGrowth  = 0.08;
    } else {
        fedInflationCool = (2.0 - Q.inflation) * 0.03;
        fedDragOnGrowth  = (2.5 - Q.economic_growth) * 0.04;
    }

    // Update GDP Growth, Inflation, and Unemployment
    Q.economic_growth = +Math.max(-6.0, Math.min(8.5, Q.economic_growth + fedDragOnGrowth + fiscalGrowthImpulse)).toFixed(2);
    Q.inflation       = +Math.max(0.2, Math.min(12.0, Q.inflation + laborInflation + fedInflationCool + fiscalInflationImpulse)).toFixed(2);

    var jobChange = (2.2 - Q.economic_growth) * 0.04;
    Q.unemployment = +Math.max(3.2, Math.min(15.0, Q.unemployment + jobChange)).toFixed(2);

  


       // ============================================================================
    // UPDATE U.S. NOMINAL GDP ($ TRILLIONS)
    // ============================================================================
    var gRate = Number(Q.economic_growth);
    if (isNaN(gRate)) gRate = 4.0;

    var curGdp = Number(Q.us_gdp);
    if (isNaN(curGdp) || curGdp <= 0) curGdp = 21.8;

    // Converts annualized GDP growth % into monthly % change (e.g., 4.0% -> +0.33%/mo)
    Q.us_gdp = +(curGdp * (1 + gRate / 1200)).toFixed(2);

    // ============================================================================
    // S&P 500 MONTHLY CALCULATION (WITH REALISTIC MARKET SWINGS)
    // ============================================================================
    var iRate = Number(Q.inflation);
    if (isNaN(iRate)) iRate = 1.4;

    var uRate = Number(Q.unemployment);
    if (isNaN(uRate)) uRate = 6.3;

    var fedDrag      = Math.max(0, Number(Q.fed_stance) || 0) * 0.005;
    var growthFactor = (gRate - 2.0) * 0.0025;
    var infPenalty   = Math.max(0, iRate - 2.5) * 0.003;
    var unempPenalty = Math.max(0, uRate - 5.0) * 0.002;

    // Realistic monthly Wall Street volatility (-2.8% to +3.0% swings + occasional pullback/rally)
    var noise = (Math.random() - 0.48) * 0.058;
    var roll = Math.random();
    if (roll < 0.12) {
        noise -= 0.025; // 12% chance of a sudden market pullback (-2.5%)
    } else if (roll > 0.88) {
        noise += 0.025; // 12% chance of a strong earnings rally (+2.5%)
    }

    var macroPct = Math.max(-0.08, Math.min(0.08, 0.004 + growthFactor - infPenalty - unempPenalty - fedDrag + noise));
    var eventPct = (Number(Q.sp500_event_pct) || 0) / 100;
    var eventMod = Number(Q.sp500_event_mod) || 0;

    var currentSp = Number(Q.sp500);
    if (isNaN(currentSp) || currentSp <= 0) currentSp = 3714;

    Q.sp500 = Math.max(500, Math.round(currentSp * (1 + macroPct + eventPct) + eventMod));
    Q.sp_500 = Q.sp500;
    Q.sp500_event_pct = 0;
    Q.sp500_event_mod = 0;


    // ============================================================================
    // HONEYMOON DECAY
    // ============================================================================
    if ((Q.year - 1) % 4 === 0 && Q.month >= 2 && Q.month <= 7) {
        if (Q.month <= 3) {
            Q.nat_flat_buff -= 1;
            Q.nat_senate_buff = (Q.nat_senate_buff || 0) + 0.5;
        } else {
            Q.nat_flat_buff -= 0.5;
            Q.nat_senate_buff = (Q.nat_senate_buff || 0) + 0.25;
        }
    }

    // ============================================================================
    // EXECUTIVE ORDER RECHARGE & AFGHANISTAN COUNTDOWN
    // ============================================================================
    if (Q.executive_orders < 3) {
        Q.eo_recharge_timer = (Q.eo_recharge_timer || 0) + 1;
        if (Q.eo_recharge_timer >= 3) {
            Q.executive_orders += 1;
            Q.eo_recharge_timer = 0;
        }
    } else {
        Q.eo_recharge_timer = 0;
    }

    if (Q.afgan_withdraw_month > 0) {
        Q.afgan_withdraw_month -= 1;
    }
}
if (Q.afgan_failure_massive_poll_rebound > 0 ) {
    Q.afgan_failure_massive_poll_rebound -= 1
    Q.nat_flat_buff += 0.15;
}
  // ============================================================================
    // ECONOMIC TO DEMOGRAPHIC POLLING (RECOVERABLE OFFSET + LINGERING TRAUMA)
    // ============================================================================
    if (Q.nat_support && Q.nat_support.inc && Q.nat_support.age) {
        if (!Q.econ_applied_offset) {
            Q.econ_applied_offset = { inc_low: 0, inc_mid: 0, inc_high: 0, age_youth: 0, age_mid: 0, age_old: 0, geo_suburban: 0, edu_noncollege: 0 };
        }
        if (!Q.econ_trauma) {
            Q.econ_trauma = { inc_low: 0, inc_mid: 0, inc_high: 0, age_youth: 0, age_mid: 0, age_old: 0, geo_suburban: 0, edu_noncollege: 0 };
        }

        var infNow   = Number(Q.inflation) || 1.4;
        var unempNow = Number(Q.unemployment) || 6.3;
        var gdpNow   = Number(Q.economic_growth) || 4.0;
        var spNow    = Number(Q.sp500) || 3714;

        // 1. Calculate current instantaneous mood for each metric (works both ways, capped)
        // Inflation: neutral at 2.3% (hurts/helps descending by income: low > mid > high)
        var infDiff = Math.max(-2.0, Math.min(4.5, 2.3 - infNow)); // Positive when inf < 2.3%, negative when > 2.3%

        // Unemployment: neutral at 5.0% (lower = positive boost, higher = negative hit)
        var unempDiff = Math.max(-4.0, Math.min(2.0, 5.0 - unempNow));

        // GDP Growth: neutral at 2.5%
        var gdpDiff = Math.max(-4.5, Math.min(2.5, gdpNow - 2.5));

        // S&P 500: neutral vs 3,714 baseline (+10% rally = +1.0, -15% drop = -1.5)
        var spPctFromStart = (spNow - 3714) / 3714;
        var spMood = Math.max(-2.5, Math.min(2.0, spPctFromStart * 8.0));

        // 2. Map metrics to target demographic offsets (clamped so bad economy hurts without nuking)
        var targets = {
            inc_low:        Math.max(-4.5, Math.min(3.0, infDiff * 0.95 + unempDiff * 0.65)),
            inc_mid:        Math.max(-3.8, Math.min(2.8, infDiff * 0.65 + unempDiff * 0.45 + gdpDiff * 0.25)),
            inc_high:       Math.max(-3.0, Math.min(2.5, infDiff * 0.25 + spMood * 0.75 + gdpDiff * 0.20)),
            age_youth:      Math.max(-3.5, Math.min(2.5, unempDiff * 0.70 + infDiff * 0.40)),
            age_mid:        Math.max(-3.5, Math.min(2.5, gdpDiff * 0.45 + infDiff * 0.50)),
            age_old:        Math.max(-3.8, Math.min(2.5, spMood * 0.85 + infDiff * 0.35)),
            geo_suburban:   Math.max(-3.5, Math.min(2.5, gdpDiff * 0.45 + infDiff * 0.45 + spMood * 0.25)),
            edu_noncollege: Math.max(-4.0, Math.min(2.8, infDiff * 0.70 + unempDiff * 0.50))
        };

        // 3. Update trauma memory & apply only the net delta to Q.nat_support
        var mapToSupport = function(key, obj, prop) {
            var target = targets[key];
            var trauma = Q.econ_trauma[key] || 0;

            if (target < 0) {
                // Bad economy builds lingering trauma up to 35% of the current pain (capped at -1.5)
                var targetTrauma = Math.max(-1.5, target * 0.35);
                if (targetTrauma < trauma) {
                    trauma = +(trauma + (targetTrauma - trauma) * 0.25).toFixed(3); // Builds gradually
                } else {
                    trauma = +(trauma * 0.90).toFixed(3); // Slowly eases if pain lessens
                }
            } else {
                // Good/recovered economy heals lingering trauma by 15% per month
                trauma = +(trauma * 0.85).toFixed(3);
                if (Math.abs(trauma) < 0.02) trauma = 0;
            }

            Q.econ_trauma[key] = trauma;
            var newEffective = +(target + trauma).toFixed(3);
            var oldApplied = Q.econ_applied_offset[key] || 0;
            var delta = +(newEffective - oldApplied).toFixed(3);

            obj[prop] = +(obj[prop] + delta).toFixed(3);
            Q.econ_applied_offset[key] = newEffective;
        };

        mapToSupport('inc_low', Q.nat_support.inc, 'low');
        mapToSupport('inc_mid', Q.nat_support.inc, 'mid');
        mapToSupport('inc_high', Q.nat_support.inc, 'high');
        mapToSupport('age_youth', Q.nat_support.age, 'youth');
        mapToSupport('age_mid', Q.nat_support.age, 'mid');
        mapToSupport('age_old', Q.nat_support.age, 'old');
        if (Q.nat_support.geo) mapToSupport('geo_suburban', Q.nat_support.geo, 'suburban');
        if (Q.nat_support.edu) mapToSupport('edu_noncollege', Q.nat_support.edu, 'noncollege');
    }
if (window.simulate_polling) {
    window.simulate_polling();
}

Q.has_event = 0;
// check if there are any cards in #event, and then go to main if not.
var scene = this.game.scenes['post_event.events_choice'];
var choices = this._compileChoices(scene);
if (choices && choices[0].title != "Continue...") {
    Q.has_event = 1;
} else {
    Q.has_event = 0;
}
// pre-load all of the event images
if (this.ui && this.ui.show_portraits) {
    for (var choice of choices) {
        var cc = this.game.scenes[choice.id];
        if (cc.faceImage) {
            var im = new Image();
            im.url = cc.faceImage;
        }
    }
}

if (typeof window !== "undefined" && window.generateBar) {
}
!}
go-to: events_choice if has_event = 1; main if has_event = 0 and (difficulty = 0 or difficulty = 1 or hand_size == 3); main.main_easy if has_event = 0 and (difficulty < 0 or hand_size == 4)

= [+ month : month +] [+ year +]

@events_choice

- #event

# This scene is solely for updating numbers after events, and routing to special events.
